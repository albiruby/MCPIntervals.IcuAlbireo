# TrackLab MCP Environment Variables

# MCP Server Configuration
PORT=3000
MCP_TRANSPORT=stdio # stdio or sse
LOG_LEVEL=info

# Intervals.icu Provider Credentials
INTERVALS_API_KEY=your_intervals_api_key_here
